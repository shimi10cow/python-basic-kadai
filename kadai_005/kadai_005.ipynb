      "source": [
        "# 台形の上底・下底・高さを入力\n",
        "upper_base = 5\n",
        "lower_base = 9\n",
        "height = 4\n",
        "\n",
        "# 台形の面積を計算\n",
        "area = (upper_base + lower_base) * height / 2\n",
        "\n",
        "# 結果を出力\n",
        "print(f\"{area}cm²\")"
      ]
    }
